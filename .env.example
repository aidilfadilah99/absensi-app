# Database Connection URL (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/absensi_db?schema=public"

# JWT Secret Keys
JWT_SECRET="super-secret-jwt-key-min-32-chars-long-security-key-2026"
JWT_REFRESH_SECRET="super-secret-jwt-refresh-key-min-32-chars-security-2026"

# Biometric Encryption Key (32 bytes / 256-bit hexadecimal string)
BIOMETRIC_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Application Settings
NEXT_PUBLIC_APP_NAME="PresensiPro - Absensi Biometrik & Geofence"
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Geofence & Anti-Spoofing Tolerances
MAX_GPS_ACCURACY_METERS=100
DEFAULT_GEOFENCE_RADIUS_METERS=150
FACE_MATCH_DISTANCE_THRESHOLD=0.45
